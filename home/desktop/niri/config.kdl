// Shortcuts live in binds.kdl; Noctalia generates noctalia.kdl.

// Input

gestures {
    hot-corners { off; }
}

input {
    keyboard {
        xkb {
            layout "us,ara"
            options "grp:alt_shift_toggle"
        }
        numlock
    }

    touchpad {
        tap
        tap-button-map "left-right-middle"
        click-method "clickfinger"
        natural-scroll
    }
}

// Layout and appearance

layout {
    background-color "transparent"
    center-focused-column "never"
    default-column-display "tabbed"
    gaps 8

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    default-column-width { proportion 0.5; }

    focus-ring {
        width 2
        active-color "#b8b8b8"
        inactive-color "#505050"
        urgent-color "#e06c75"
    }

    shadow {
        softness 24
        spread 1
        offset x=0 y=4
        color "#00000055"
    }

    tab-indicator {
        place-within-column
        hide-when-single-tab
    }
}

// Overview and shell integration

overview {
    backdrop-color "#000000d9"
}

environment {
    XDG_CURRENT_DESKTOP "niri"
}

hotkey-overlay { skip-at-startup; }

layer-rule {
    match namespace="^noctalia-backdrop"
    place-within-backdrop true
}

prefer-no-csd

screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

// Animations

animations {
    workspace-switch {
        spring damping-ratio=1.0 stiffness=1200 epsilon=0.001
    }

    horizontal-view-movement {
        spring damping-ratio=1.0 stiffness=1100 epsilon=0.001
    }

    window-movement {
        spring damping-ratio=1.0 stiffness=1100 epsilon=0.001
    }

    window-resize {
        spring damping-ratio=1.0 stiffness=1200 epsilon=0.001
    }

    window-open {
        duration-ms 120
        curve "ease-out-expo"
    }

    window-close {
        duration-ms 90
        curve "ease-out-quad"
    }

    overview-open-close {
        spring damping-ratio=1.0 stiffness=1200 epsilon=0.001
    }

    screenshot-ui-open {
        duration-ms 110
        curve "ease-out-quad"
    }

    config-notification-open-close {
        spring damping-ratio=1.0 stiffness=1200 epsilon=0.001
    }
}

// Window rules

window-rule {
    open-floating false
    tiled-state true
    default-column-display "tabbed"
    geometry-corner-radius 16
    clip-to-geometry true
    draw-border-with-background false

    opacity 1.00
    background-effect { blur false; }
}

window-rule {
    match app-id="com.system76.CosmicMonitor"

    match app-id="com.system76.CosmicFiles"

    opacity 0.90
    background-effect { blur true; }
    default-column-width { proportion 1.0; }
}

window-rule {
    match title=r#"^(Picture-in-Picture|Picture in picture)$"#
    open-floating false
    default-floating-position x=32 y=32 relative-to="bottom-right"
    opacity 1.00
}

// Ghostty opens at half width.
window-rule {
    match app-id=r#"^com\.mitchellh\.ghostty$"#
    opacity 1.0
    background-effect { blur true; }
    default-column-width { proportion 0.5; }
}

// Yazi opens at full width.
window-rule {
    match app-id=r#"^com\.mitchellh\.ghostty$"# title="^Yazi"
    default-column-width { proportion 1.0; }
}

window-rule {
    match app-id="brave-rust-book.cs.brown.edu__-Default"
    opacity 0.94
    background-effect { blur true; }
}

window-rule {
    match app-id="dev.zed.Zed"
    match app-id="codex-desktop"
    match app-id="dev.noctalia.Noctalia"
    match app-id="dev.zed.Delta"
    opacity 0.90
    background-effect { blur true; }
}

// Window switcher

recent-windows {
    binds {
        Alt+Tab { next-window scope="all"; }
        Alt+Shift+Tab { previous-window scope="all"; }
        Alt+grave { next-window scope="all" filter="app-id"; }
        Alt+Shift+grave { previous-window scope="all" filter="app-id"; }
    }

    previews {
        max-height 700
        max-scale 0.72
    }

    highlight { corner-radius 16; }
}

// Graphics

debug {
    honor-xdg-activation-with-invalid-serial

    // Render on AMD; use nvidia-offload for applications.
    render-drm-device "/dev/dri/by-path/pci-0000:c5:00.0-render"
}

// Internal display

output "eDP-1" {
    mode "2880x1800@120.000"
    scale 2
    variable-refresh-rate
}

// Shortcuts and theme

include "binds.kdl"

include "noctalia.kdl"
