binds {
    // Shell

    Mod+Tab repeat=false hotkey-overlay-title="Window Overview" {
        toggle-overview
    }

    Mod+Space repeat=false hotkey-overlay-title="Applications" {
        spawn "desktop-menu"
    }

    Mod+D repeat=false hotkey-overlay-title="Commands" {
        spawn "desktop-menu"
    }

    // Copilot key sends Super+Shift+F23.
    Mod+Shift+F23 repeat=false hotkey-overlay-title="Commands" {
        spawn "desktop-menu"
    }

    Mod+T repeat=false hotkey-overlay-title="Terminal" {
        spawn "ghostty"
    }

    Mod+Return repeat=false hotkey-overlay-title="Terminal" {
        spawn "ghostty"
    }

    Mod+E repeat=false hotkey-overlay-title="Files" {
        spawn "ghostty" "-e" "yazi"
    }

    Mod+Z repeat=false hotkey-overlay-title="Zed Editor" {
        spawn "zeditor"
    }

    Mod+B repeat=false hotkey-overlay-title="Web Browser" {
        spawn "firefox"
    }

    Mod+V repeat=false hotkey-overlay-title="Clipboard" {
        spawn "noctalia" "msg" "panel-toggle" "clipboard"
    }

    Mod+Ctrl+B repeat=false hotkey-overlay-title="Cycle bar layout" {
        spawn "shadow" "layout" "cycle"
    }

    Mod+W repeat=false hotkey-overlay-title="Wallpapers" {
        spawn "noctalia" "msg" "panel-toggle" "wallpaper"
    }

    Mod+Comma repeat=false hotkey-overlay-title="Settings" {
        spawn "noctalia" "msg" "panel-toggle" "settings"
    }

    Mod+N repeat=false hotkey-overlay-title="Notifications" {
        spawn "noctalia" "msg" "panel-toggle" "control-center" "notifications"
    }

    Mod+X repeat=false hotkey-overlay-title="Power Menu" {
        spawn "noctalia" "msg" "panel-toggle" "session"
    }

    Mod+Shift+Slash repeat=false hotkey-overlay-title="Keyboard Shortcuts" {
        show-hotkey-overlay
    }

    // Session and security

    Mod+Alt+L repeat=false allow-inhibiting=false hotkey-overlay-title="Lock Screen" {
        spawn "noctalia" "msg" "session" "lock"
    }

    // Shows niri's confirmation dialog.
    Mod+Shift+E repeat=false hotkey-overlay-title="Exit niri" {
        quit
    }

    // Allow shortcut inhibition to be escaped in games, VMs and remote sessions.
    Mod+Escape repeat=false allow-inhibiting=false hotkey-overlay-title="Release Captured Shortcuts" {
        toggle-keyboard-shortcuts-inhibit
    }

    Mod+Shift+P repeat=false hotkey-overlay-title="Turn Off Display" {
        power-off-monitors
    }

    // Audio and media

    XF86AudioRaiseVolume allow-when-locked=true {
        spawn "wpctl" "set-volume" "-l" "1.0" "@DEFAULT_AUDIO_SINK@" "3%+"
    }

    XF86AudioLowerVolume allow-when-locked=true {
        spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "3%-"
    }

    XF86AudioMute allow-when-locked=true {
        spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SINK@" "toggle"
    }

    XF86AudioMicMute allow-when-locked=true {
        spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SOURCE@" "toggle"
    }

    XF86AudioPause allow-when-locked=true {
        spawn "playerctl" "play-pause"
    }

    XF86AudioPlay allow-when-locked=true {
        spawn "playerctl" "play-pause"
    }

    XF86AudioPrev allow-when-locked=true {
        spawn "playerctl" "previous"
    }

    XF86AudioNext allow-when-locked=true {
        spawn "playerctl" "next"
    }

    // Brightness

    // Select AMD’s backlight; automatic selection may choose NVIDIA.
    XF86MonBrightnessUp allow-when-locked=true {
        spawn "brightnessctl" "--device" "amdgpu_bl1" "set" "5%+"
    }

    XF86MonBrightnessDown allow-when-locked=true {
        spawn "brightnessctl" "--device" "amdgpu_bl1" "set" "5%-"
    }

    // Window state

    Mod+Q repeat=false hotkey-overlay-title="Close Window" {
        close-window
    }

    Mod+F repeat=false hotkey-overlay-title="Maximize Column" {
        maximize-column
    }

    Mod+Shift+F repeat=false hotkey-overlay-title="Fullscreen Window" {
        fullscreen-window
    }

    Mod+Shift+B repeat=false hotkey-overlay-title="Toggle Bar" {
        spawn "noctalia" "msg" "bar-toggle"
    }

    Mod+Shift+T repeat=false hotkey-overlay-title="Toggle Floating" {
        toggle-window-floating
    }

    Mod+Shift+V repeat=false hotkey-overlay-title="Focus Floating or Tiled" {
        switch-focus-between-floating-and-tiling
    }

    Mod+Shift+W repeat=false hotkey-overlay-title="Toggle Column Tabs" {
        toggle-column-tabbed-display
    }

    // Window focus

    // Left/right focus columns; up/down switch workspace rows.
    Mod+Left {
        focus-column-left
    }

    Mod+Right {
        focus-column-right
    }

    Mod+Down {
        focus-workspace-down
    }

    Mod+Up {
        focus-workspace-up
    }

    // Move columns horizontally

    Mod+Shift+Left hotkey-overlay-title=null {
        move-column-left
    }

    Mod+Shift+Right hotkey-overlay-title=null {
        move-column-right
    }

    // Column positions

    Mod+Home {
        focus-column-first
    }

    Mod+End {
        focus-column-last
    }

    Mod+Ctrl+Home {
        move-column-to-first
    }

    Mod+Ctrl+End {
        move-column-to-last
    }

    // Workspaces

    Mod+Shift+Down hotkey-overlay-title="Move Window to Workspace Below" {
        move-window-to-workspace-down
    }

    Mod+Shift+Up hotkey-overlay-title="Move Window to Workspace Above" {
        move-window-to-workspace-up
    }

    Mod+Ctrl+Page_Down hotkey-overlay-title="Move Column to Next Workspace" {
        move-column-to-workspace-down
    }

    Mod+Ctrl+Page_Up hotkey-overlay-title="Move Column to Previous Workspace" {
        move-column-to-workspace-up
    }

    Mod+Shift+Page_Down hotkey-overlay-title=null {
        move-workspace-down
    }

    Mod+Shift+Page_Up hotkey-overlay-title=null {
        move-workspace-up
    }

    // Numbered workspaces

    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }

    Mod+Shift+1 { move-column-to-workspace 1; }
    Mod+Shift+2 { move-column-to-workspace 2; }
    Mod+Shift+3 { move-column-to-workspace 3; }
    Mod+Shift+4 { move-column-to-workspace 4; }
    Mod+Shift+5 { move-column-to-workspace 5; }
    Mod+Shift+6 { move-column-to-workspace 6; }
    Mod+Shift+7 { move-column-to-workspace 7; }
    Mod+Shift+8 { move-column-to-workspace 8; }
    Mod+Shift+9 { move-column-to-workspace 9; }

    // Column grouping and tabs

    // Join or split adjacent columns.
    Mod+Alt+Left { consume-or-expel-window-left; }
    Mod+Alt+Right { consume-or-expel-window-right; }

    // Reach vertically stacked windows without switching workspace rows.
    Mod+Alt+Down { focus-window-down; }
    Mod+Alt+Up { focus-window-up; }

    Mod+Period hotkey-overlay-title="Remove from Column" {
        expel-window-from-column
    }

    Mod+Ctrl+Tab hotkey-overlay-title="Next Tab" { focus-window-down; }
    Mod+Ctrl+Shift+Tab hotkey-overlay-title="Previous Tab" { focus-window-up; }

    // Size and positioning

    Mod+R hotkey-overlay-title="Cycle Column Width" {
        switch-preset-column-width
    }

    Mod+Ctrl+F hotkey-overlay-title="Fill Available Width" {
        expand-column-to-available-width
    }

    Mod+C hotkey-overlay-title="Center Column" {
        center-column
    }

    Mod+Ctrl+C hotkey-overlay-title="Center Visible Columns" {
        center-visible-columns
    }

    // Column width.
    Mod+Minus {
        set-column-width "-10%"
    }

    Mod+Equal {
        set-column-width "+10%"
    }

    // Window height.
    Mod+Shift+Minus hotkey-overlay-title="Decrease Window Height" {
        set-window-height "-10%"
    }

    Mod+Shift+Equal hotkey-overlay-title="Increase Window Height" {
        set-window-height "+10%"
    }

    // External monitors

    // Keep external-monitor bindings hidden on the usual single-output setup.
    Mod+Ctrl+Down hotkey-overlay-title=null {
        focus-monitor-down
    }

    Mod+Ctrl+Up hotkey-overlay-title=null {
        focus-monitor-up
    }

    Mod+Ctrl+Left hotkey-overlay-title=null {
        focus-monitor-left
    }

    Mod+Ctrl+Right hotkey-overlay-title=null {
        focus-monitor-right
    }

    Mod+Shift+Ctrl+Left hotkey-overlay-title=null {
        move-column-to-monitor-left
    }

    Mod+Shift+Ctrl+Down hotkey-overlay-title=null {
        move-column-to-monitor-down
    }

    Mod+Shift+Ctrl+Up hotkey-overlay-title=null {
        move-column-to-monitor-up
    }

    Mod+Shift+Ctrl+Right hotkey-overlay-title=null {
        move-column-to-monitor-right
    }

    // Two-axis wheel and touchpad navigation. Shift moves the column.

    Mod+WheelScrollDown cooldown-ms=150 { focus-workspace-down; }
    Mod+Shift+WheelScrollDown cooldown-ms=150 { move-column-to-workspace-down; }
    Mod+WheelScrollUp cooldown-ms=150 { focus-workspace-up; }
    Mod+Shift+WheelScrollUp cooldown-ms=150 { move-column-to-workspace-up; }
    Mod+WheelScrollLeft cooldown-ms=150 { focus-column-left; }
    Mod+Shift+WheelScrollLeft cooldown-ms=150 { move-column-left; }
    Mod+WheelScrollRight cooldown-ms=150 { focus-column-right; }
    Mod+Shift+WheelScrollRight cooldown-ms=150 { move-column-right; }

    Mod+TouchpadScrollDown cooldown-ms=150 { focus-workspace-down; }
    Mod+Shift+TouchpadScrollDown cooldown-ms=150 { move-column-to-workspace-down; }
    Mod+TouchpadScrollUp cooldown-ms=150 { focus-workspace-up; }
    Mod+Shift+TouchpadScrollUp cooldown-ms=150 { move-column-to-workspace-up; }
    Mod+TouchpadScrollLeft cooldown-ms=150 { focus-column-left; }
    Mod+Shift+TouchpadScrollLeft cooldown-ms=150 { move-column-left; }
    Mod+TouchpadScrollRight cooldown-ms=150 { focus-column-right; }
    Mod+Shift+TouchpadScrollRight cooldown-ms=150 { move-column-right; }

    // Screenshots

    Print repeat=false hotkey-overlay-title="Screenshot Area" {
        screenshot show-pointer=false
    }

    Ctrl+Print repeat=false hotkey-overlay-title="Screenshot Screen" {
        screenshot-screen show-pointer=false
    }

    Alt+Print repeat=false hotkey-overlay-title="Screenshot Window" {
        screenshot-window
    }

    // Laptop-specific screenshot key.
    XF86Launch1 repeat=false hotkey-overlay-title=null {
        screenshot show-pointer=false
    }

    Ctrl+XF86Launch1 repeat=false hotkey-overlay-title=null {
        screenshot-screen show-pointer=false
    }

    Alt+XF86Launch1 repeat=false hotkey-overlay-title=null {
        screenshot-window
    }
}
