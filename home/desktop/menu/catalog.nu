export def categories [] {
    [[id label icon description];
        [applications Applications '󰀻' 'Installed apps · Noctalia pins first']
        [wallpapers Wallpapers '󰸉' 'Picker, filters, shuffle and history']
        [appearance Appearance '󰏘' 'Theme, night light and desktop settings']
        [nix NixOS '' 'Build, test, update and maintain the system']
        [power 'Power & Travel' '󰁹' 'Battery profiles, focus and presentation']
        [display Displays '󰍹' 'Resolution, refresh rate and brightness']
        [audio Audio '󰕾' 'Speakers, microphone and volume']
        [network Connectivity '󰖩' 'Wi-Fi and Bluetooth devices']
        [capture Capture '󰄀' 'Screenshots, annotation and recording']
        [tools Tools '󰒓' 'Applications, projects and system diagnostics']
        [session Session '󰐥' 'Lock, suspend, log out or power off']
    ]
}

# Argument arrays are data, never shell source. The same catalog powers CLI and UI.
export def actions [] {
    [[id group label description kind args terminal confirm];
        [wallpaper-picker wallpapers 'Wallpaper picker' 'Open the existing Noctalia image browser' exec [noctalia msg panel-open wallpaper] false false]
        [wallpaper-tag wallpapers 'Filter by tag' 'Choose a filename tag for cycling' wallpaper [select tag] false false]
        [wallpaper-name wallpapers 'Filter by name' 'Choose a work or collection name' wallpaper [select name] false false]
        [wallpaper-all wallpapers 'Clear wallpaper filter' 'Cycle the entire library' wallpaper [all] false false]
        [wallpaper-next wallpapers 'Next wallpaper' 'Next image in the active filter' wallpaper [next] false false]
        [wallpaper-previous wallpapers 'Previous wallpaper' 'Previous image in the active filter' wallpaper [previous] false false]
        [wallpaper-random wallpapers 'Shuffle wallpaper' 'Use a shuffled bag without repeats' wallpaper [random] false false]
        [wallpaper-history wallpapers 'Wallpaper history' 'Restore an image used through these controls' wallpaper [history] false false]
        [wallpaper-folder wallpapers 'Open wallpaper folder' 'Browse the original files in Yazi' folder [Pictures Wallpapers] false false]
        [panel-opacity appearance 'Panel opacity' 'Solid backgrounds, or translucent panels with blur' opacity [] false false]
        [bar-layout appearance 'Bar layout' 'Bottom bar, GNOME top bar + dock, or right sidebar' layout [] false false]
        [theme appearance 'Toggle light / dark' 'Change Noctalia appearance' exec [noctalia msg theme-mode-toggle] false false]
        [settings appearance Settings 'Open Noctalia settings' exec [noctalia msg settings-open] false false]
        [nightlight appearance 'Toggle night light' 'Warmer display colors' exec [noctalia msg nightlight-toggle] false false]
        [bar appearance 'Toggle bar' 'Show or hide the desktop bar' exec [noctalia msg bar-toggle] false false]
        [check nix 'Check configuration' 'Evaluate flake checks; no activation' nix [check] true false]
        [build nix 'Build system' 'Build and show changes; no activation' nix [build] true false]
        [test nix 'Test temporarily' 'Activate now; keep previous boot default; NH asks' nix [test] true false]
        [switch nix 'Switch system' 'Activate now and change boot default; NH asks' nix [switch] true false]
        [boot nix 'Prepare next boot' 'Change boot default without activating now; NH asks' nix [boot] true false]
        [update nix 'Update inputs and build' 'Changes flake.lock after confirmation; no activation' nix [update] true false]
        [update-input nix 'Update one input' 'Choose a locked input; confirm, update and build' nix [input] true false]
        [generations nix Generations 'Inspect system versions and closure sizes' nix [generations] true false]
        [rollback nix 'Rollback system' 'Return to previous generation; NH asks' nix [rollback] true false]
        [clean-preview nix 'Preview cleanup' 'Dry run; retain 5 generations and 14 days; preserve gcroots' nix [clean-preview] true false]
        [clean nix 'Clean old generations' 'Retain 5 generations and 14 days; preserve gcroots; NH asks' nix [clean] true false]
        [optimise nix 'Deduplicate Nix store' 'Share identical store files after confirmation' nix [optimise] true false]
        [packages nix 'Search packages' 'Search Nixpkgs; does not install anything' search [search] true false]
        [options nix 'Search NixOS options' 'Find configuration options' search [options] true false]
        [edit nix 'Edit configuration' 'Open /saved/nixos-config in Zed' exec [zeditor /saved/nixos-config] false false]
        [fastfetch tools Fastfetch 'Show the configured system information in a terminal' exec [fastfetch] true false]
        [status tools 'System summary' 'Running vs boot configuration, storage, battery and GPU state' status [] true false]
        [travel power 'Travel mode' 'Long trip: 60 Hz, power-saver, 30% brightness; save previous settings' mode [travel] false true]
        [restore power 'Restore before Travel' 'Restore saved display modes, brightness and power profile' mode [restore] false true]
        [saver power 'Power saver' 'Set power-saver CPU policy' exec [powerprofilesctl set power-saver] false false]
        [balanced power Balanced 'Set balanced CPU policy' exec [powerprofilesctl set balanced] false false]
        [performance power Performance 'Set performance CPU policy' exec [powerprofilesctl set performance] false false]
        [dnd power 'Do Not Disturb' 'Toggle notification interruptions' exec [noctalia msg notification-dnd-toggle] false false]
        [caffeine power 'Keep awake' 'Toggle the Noctalia idle inhibitor' exec [noctalia msg caffeine-toggle] false false]
        [focus power 'Focus mode' 'Silence notifications; save previous state' focus [focus] false false]
        [presentation power 'Presentation mode' 'Silence notifications and inhibit idle/sleep until restored' focus [presentation] false false]
        [focus-restore power 'Restore before Focus' 'Restore notifications and release our Presentation inhibitor' focus [restore] false false]
        [display-mode display 'Resolution & refresh rate' 'Choose an output and a supported mode' display [] false false]
        [display-info display 'Display information' 'Inspect connected outputs and modes' outputs [] true false]
        [screen-off display 'Turn screens off' 'Wake with keyboard or mouse' exec [noctalia msg dpms-off] false false]
        [brightness-up display 'Brightness up' 'Increase backlight brightness' exec [noctalia msg brightness-up] false false]
        [brightness-down display 'Brightness down' 'Decrease backlight brightness' exec [noctalia msg brightness-down] false false]
        [audio-panel audio 'Audio devices' 'Choose speakers, headphones or microphone in Noctalia' exec [noctalia msg panel-open control-center audio] false false]
        [mute audio 'Mute speakers' 'Toggle output mute' exec [noctalia msg volume-mute] false false]
        [mic audio 'Mute microphone' 'Toggle input mute' exec [noctalia msg mic-mute] false false]
        [quieter audio 'Volume down' 'Decrease output volume' exec [noctalia msg volume-down] false false]
        [louder audio 'Volume up' 'Increase output volume' exec [noctalia msg volume-up] false false]
        [wifi network 'Wi-Fi networks' 'Open Noctalia network controls' exec [noctalia msg panel-open control-center network] false false]
        [bluetooth network 'Bluetooth devices' 'Open Noctalia Bluetooth controls' exec [noctalia msg panel-open control-center bluetooth] false false]
        [bluetooth-off network 'Turn Bluetooth off' 'Disable Bluetooth for travel' exec [noctalia msg bluetooth-disable] false false]
        [bluetooth-on network 'Turn Bluetooth on' 'Enable Bluetooth' exec [noctalia msg bluetooth-enable] false false]
        [region capture 'Capture region' 'Select an area to screenshot' exec [noctalia msg screenshot-region] false false]
        [window capture 'Capture window' 'Screenshot the focused window' exec [noctalia msg screenshot-window] false false]
        [fullscreen capture 'Capture screen' 'Screenshot the focused monitor' exec [noctalia msg screenshot-fullscreen] false false]
        [annotate capture 'Annotate screenshot' 'Freeze the screen and draw' exec [noctalia msg screenshot-annotate] false false]
        [record capture 'Start recording' 'Select a capture target with the Noctalia recorder' exec [noctalia msg plugin 'noctalia/screen_recorder:service' service start portal] false false]
        [record-stop capture 'Stop recording' 'Finish and save the current Noctalia recording' exec [noctalia msg plugin 'noctalia/screen_recorder:service' service stop] false false]
        [record-settings capture 'Recording settings' 'Configure the installed recorder plugin' exec [noctalia msg settings-open-plugin 'noctalia/screen_recorder'] false false]
        [clipboard tools Clipboard 'Open Noctalia clipboard history' exec [noctalia msg panel-open clipboard] false false]
        [emoji tools Emoji 'Open the Noctalia emoji provider' exec [noctalia msg panel-open launcher /emo] false false]
        [apps tools Applications 'Launch installed applications with Rofi' exec [desktop-menu applications] false false]
        [terminal tools Terminal 'Open Ghostty with Nushell' exec [ghostty] false false]
        [files tools Files 'Open Yazi' exec [ghostty -e yazi] false false]
        [projects tools Projects 'Find a Git checkout under ~/Projects and open Zed' projects [] false false]
        [failed tools 'Failed system services' 'Inspect system unit failures' exec [systemctl --failed --no-pager] true false]
        [failed-user tools 'Failed user services' 'Inspect desktop unit failures' exec [systemctl --user --failed --no-pager] true false]
        [logs tools 'Recent system warnings' 'View this boot’s warnings and errors' exec [journalctl -b -p warning -n 100 --no-pager] true false]
        [disk tools 'Storage pressure' 'Show persistent storage and temporary home space' exec [df -h /nix /saved /home /tmp] true false]
        [shortcuts tools 'Keyboard shortcuts' 'Show the current compositor shortcut guide' shortcuts [] false false]
        [lock session Lock 'Lock the current session' exec [noctalia msg session lock] false false]
        [suspend session Suspend 'Suspend the laptop' exec [noctalia msg session suspend] false true]
        [sessions session 'Change desktop session' 'Log out, then choose Niri or Umbriel in the greeter; apps close' session [] false true]
        [logout session 'Log out' 'Close the desktop session and return to the greeter' exec [noctalia msg session logout] false true]
        [reboot session Restart 'Reboot the computer' exec [noctalia msg session reboot] false true]
        [shutdown session 'Power off' 'Shut down the computer' exec [noctalia msg session shutdown] false true]
    ]
}
