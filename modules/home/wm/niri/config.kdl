// Main niri configuration.
// Additional key bindings live in binds.kdl.
// Noctalia generates noctalia.kdl automatically.

// ─────────────────────────────────────────────────────────────────────────────
// Input
// ─────────────────────────────────────────────────────────────────────────────

gestures {
    hot-corners { off; }
}

input {
    keyboard {
        xkb {
            layout "us,ara"
            options "grp:win_space_toggle"
        }
        numlock
    }

    touchpad {
        tap
        tap-button-map "left-right-middle"
        click-method "clickfinger"
        natural-scroll
    }
}

// ─────────────────────────────────────────────────────────────────────────────
// Layout
// ─────────────────────────────────────────────────────────────────────────────

layout {
    background-color "transparent"
    center-focused-column "never"
    gaps 8

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    default-column-width { proportion 0.5; }

    border { off; }

    focus-ring {
        width 1
        active-color "#b8b8b8"
        inactive-color "#505050"
        urgent-color "#e06c75"
    }

    shadow {
        softness 24
        spread 1
        offset x=0 y=4
        color "#00000055"
    }

    tab-indicator {
        place-within-column
        hide-when-single-tab
    }
}

// ─────────────────────────────────────────────────────────────────────────────
// Overview and shell integration
// ─────────────────────────────────────────────────────────────────────────────

overview {
    backdrop-color "#000000d9"
}

environment {
    XDG_CURRENT_DESKTOP "niri"
}

hotkey-overlay { skip-at-startup; }

layer-rule {
    match namespace="^noctalia-backdrop"
    place-within-backdrop true
}

prefer-no-csd

screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

// ─────────────────────────────────────────────────────────────────────────────
// Animations
// ─────────────────────────────────────────────────────────────────────────────

animations {
    workspace-switch {
        spring damping-ratio=0.66 stiffness=420 epsilon=0.0001
    }

    horizontal-view-movement {
        spring damping-ratio=0.74 stiffness=390 epsilon=0.0001
    }

    window-movement {
        spring damping-ratio=0.60 stiffness=350 epsilon=0.0001
    }

    window-resize {
        spring damping-ratio=0.80 stiffness=450 epsilon=0.0001
    }

    window-open {
        duration-ms 175
        curve "ease-out-expo"
    }

    window-close {
        duration-ms 140
        curve "ease-out-quad"
    }

    overview-open-close {
        spring damping-ratio=0.72 stiffness=580 epsilon=0.0001
    }

    screenshot-ui-open {
        duration-ms 170
        curve "ease-out-quad"
    }

    config-notification-open-close {
        spring damping-ratio=0.70 stiffness=680 epsilon=0.001
    }
}

// ─────────────────────────────────────────────────────────────────────────────
// Window behavior
// ─────────────────────────────────────────────────────────────────────────────

window-rule {
    open-floating false
    tiled-state true
    default-column-display "tabbed"
    geometry-corner-radius 16
    clip-to-geometry true
    draw-border-with-background false
}

window-rule {
    match app-id=r#"^org\.gnome\.Calculator$"#
    match app-id=r#"^gnome-calculator$"#
    match app-id=r#"^galculator$"#
    match app-id=r#"^blueman-manager$"#
    match app-id=r#"^pavucontrol$"#
    match app-id=r#"^nm-connection-editor$"#

    default-column-width { proportion 0.33333; }
}

// Keep transient utility windows tiled by default, but make Picture-in-Picture
// genuinely useful without changing the global no-auto-floating policy.
window-rule {
    match title=r#"^(Picture-in-Picture|Picture in picture)$"#
    open-floating true
    default-floating-position x=32 y=32 relative-to="bottom-right"
}

// ─────────────────────────────────────────────────────────────────────────────
// Recent-window switcher
// ─────────────────────────────────────────────────────────────────────────────

recent-windows {
    binds {
        Alt+Tab { next-window scope="all"; }
        Alt+Shift+Tab { previous-window scope="all"; }
        Alt+grave { next-window scope="all" filter="app-id"; }
        Alt+Shift+grave { previous-window scope="all" filter="app-id"; }
    }

    previews {
        max-height 700
        max-scale 0.72
    }

    highlight { corner-radius 16; }
}

// ─────────────────────────────────────────────────────────────────────────────
// Graphics
// ─────────────────────────────────────────────────────────────────────────────

debug {
    honor-xdg-activation-with-invalid-serial

    // Keep niri on the Radeon 880M. Applications can use the RTX 5060 through
    // nvidia-offload without moving the compositor to the discrete GPU.
    render-drm-device "/dev/dri/by-path/pci-0000:c5:00.0-render"
}

// ─────────────────────────────────────────────────────────────────────────────
// Internal display
// ─────────────────────────────────────────────────────────────────────────────

output "Samsung Display Corp. ATNA40CU05-0  Unknown" {
    mode "2880x1800@60.001"
    scale 2
    position x=0 y=0
}

// ─────────────────────────────────────────────────────────────────────────────
// Included configuration
// ─────────────────────────────────────────────────────────────────────────────

include "binds.kdl"
include "noctalia.kdl"
