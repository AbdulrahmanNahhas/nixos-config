# Single source of truth for Zed extensions: installed via
# programs.zed-editor.extensions (default.nix) and mirrored into
# auto_install_extensions (settings.nix) so Zed doesn't prompt to install
# or update them itself.
[
  "biome"
  "nix"
  "toml"
  "vercel-theme"
  "rainbow-csv"
  "comment"
  "charmed-icons"
  "rich-vesper"
  "rust-and-brown"
]
