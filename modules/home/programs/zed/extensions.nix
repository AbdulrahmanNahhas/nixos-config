# Single source of truth for Zed extensions: installed via
# programs.zed-editor.extensions (default.nix) and mirrored into
# auto_install_extensions (settings.nix). Zed installs and updates them;
# Home Manager owns the desired extension list.
[
  "oxc"
  "gotmpl"
  "kdl"
  "nix"
  "toml"
  "tombi"
  "vercel-theme"
  "rainbow-csv"
  "comment"
  "charmed-icons"
  "rust-and-brown"
]
